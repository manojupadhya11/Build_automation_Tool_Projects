# OPTIONAL ONLY.
# Leave this file unused for the normal local/EC2 same-host setup.
# The frontend uses /api and Vite proxies it to http://127.0.0.1:8080.
#
# Use this only when the backend is intentionally on another host/origin:
# VITE_API_URL=https://api.example.com/api
#
# To change only the local Vite proxy target:
# VITE_PROXY_TARGET=http://127.0.0.1:8080
